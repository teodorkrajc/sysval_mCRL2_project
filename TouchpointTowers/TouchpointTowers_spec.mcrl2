% Touchpoint Towers

% Data Structures
sort Car = struct A | B; % Two cars, enumerated
	Loc = struct I | fl(wing: Car, lvl: Nat); % lvl is 1, 2, 4 or 5; I is level 3
	State = struct waiting | active | finished; % status of request
	% Request shape: (original source, original destination, current orig, current dest, status)
    Req = struct req(origSrc: Loc, origDst: Loc, src: Loc, dst: Loc, st: State);
    Pool = List(Req); % kept sorted and without duplicates by ins
	Mutex = struct free | heldBy(holder: Car); % IM mutex state

% Helper Functions
map level: Loc -> Nat; % Get the level value from Loc
	validLoc: Loc -> Bool; % Verify validity of Loc struct
	carOf: Loc -> Car; % Get the car value from Loc
	sameWing: Loc # Loc -> Bool; % Same wing check, to validate if a Car can perform a trip
	crossIntersection: Nat # Nat -> Bool; % Does a move cross / touch the intersection?
	newReq: Loc # Loc -> Req; % helper, makes new request based on incoming orig, dst tuple
	MAXPOOL: Nat; % Max number of requests in the pool

var w: Car;
	n, m: Nat;
	x, y: Loc;

eqn level(I) = 3;
	level(fl(w,n)) = n;
	validLoc(I) = true;
	validLoc(fl(w,n)) =  n>=1 && n<=5 && n!=3;
	carOf(fl(w,n)) = w;
	sameWing(x, y) = x == I || y == I || carOf(x) == carOf(y);
	crossIntersection(n, m) = min(n, m) <= 3 && 3 <= max(n, m);
	newReq(x, y) = req(x, y, x, if(sameWing(x,y), y, I), waiting); % create cross building requests if needed
	MAXPOOL = 2; % hardcoded

% Dispatcher Functions
map owner: Req -> Car; % Gives owner (car) of a request
	ins: Req # Pool -> Pool; % Insert a request to the pool
	stopsOf: Car # Pool -> FSet(Nat); % Output set of stops for a car as a sorted FSet (no duplication)
	afterVisit: Car # Nat # Pool -> Pool; % Update pool after a car does visit(e, n)
	hasFinished: Loc # Loc # Pool -> Bool; % is there a finished request for the original trip (o, d)?
	removeFinished: Loc # Loc # Pool -> Pool; % remove the finished request for the original trip (o, d)

var r, q: Req;
	p: Pool;
	e: Car;
	n: Nat;
	o, d: Loc;

eqn owner(r) = if(src(r) == I, carOf(dst(r)), carOf(src(r))); % src may be I; then dst decides
	ins(r, []) = [r]; % Insert r into empty pool
	ins(r, q |> p) = if(r == q, q |> p, if(r < q, r |> q |> p, q |> ins(r,p))); % No duplication, inorder insertion
	stopsOf(e, []) = {}; % Empty pool case
	% Pick only stops e is an owner of; e's waiting requests give src level, active give dst level
	stopsOf(e, q |> p) =
		if(owner(q) == e && st(q) == waiting, {level(src(q))},
		if(owner(q) == e && st(q) == active, {level(dst(q))},
		{}))
		+ stopsOf(e, p); 
	afterVisit(e, n, []) = []; 
	% Update pool after a visit
	afterVisit(e, n, q |> p) =
		if(owner(q) == e && st(q) == waiting && level(src(q)) == n,
			ins(req(origSrc(q), origDst(q), src(q), dst(q), active), afterVisit(e, n, p)), % board
		if (owner(q) == e && st(q) == active && level(dst(q)) == n, % passenger is on board
			ins(if(dst(q) == origDst(q), % check if current destination is final
       			req(origSrc(q), origDst(q), src(q), dst(q), finished), % home
       			req(origSrc(q), origDst(q), I, origDst(q), waiting)), % layover at I
    			afterVisit(e, n, p)),
			ins(q, afterVisit(e, n, p)))); % q untouched and kept
	hasFinished(o, d, []) = false;
	hasFinished(o, d, r |> p) =
		(st(r) == finished && origSrc(r) == o && origDst(r) == d) || hasFinished(o, d, p);
	% no duplicates in the pool, so stop at the first match
	removeFinished(o, d, []) = [];
	removeFinished(o, d, r |> p) =
		if(st(r) == finished && origSrc(r) == o && origDst(r) == d,
			p, % found: drop r
			r |> removeFinished(o, d, p)); % not this one, keep searching

% Elevator Functions (LOOK)
sort Dir = struct up | down; % current direction of movement

map nextUp: Nat # FSet(Nat) -> Nat; % nearest stop above level n; 0 if none
	nextDown: Nat # FSet(Nat) -> Nat; % nearest stop below level n; 0 if none
	target: Nat # Dir # FSet(Nat) -> Nat; % level to serve next
	newDir: Nat # Dir # FSet(Nat) -> Dir; % direction after choosing next target
	moveOne: Nat # Dir -> Nat; % move by one, only correct in I, used for parking

var n: Nat;
	d: Dir;
	S: FSet(Nat);

% conditional equations (c -> lhs = rhs)
eqn n >= 5 -> nextUp(n, S) = 0;
	n < 5 -> nextUp(n, S) = if(n + 1 in S, n + 1, nextUp(n + 1, S));
	n <= 1 -> nextDown(n, S) = 0;
	% result of n - 1 is an Int, need to turn it back to Nat; safe since n > 1
	n > 1 -> nextDown(n, S) = if(Int2Nat(n - 1) in S, Int2Nat(n - 1), nextDown(Int2Nat(n - 1), S)); 

	% serve current level first; else keep going in d; reverse if no stops ahead
	target(n, d, S) =
		if(n in S, n,
		if(d == up, if(nextUp(n, S) != 0, nextUp(n, S), nextDown(n, S)),
		            if(nextDown(n, S) != 0, nextDown(n, S), nextUp(n, S))));
	% change direction if no more stops on current direction
	newDir(n, d, S) =
		if(n in S, d,
		if(d == up, if(nextUp(n, S) != 0, up, down),
		            if(nextDown(n, S) != 0, down, up)));
	
	moveOne(n, d) = if(d == up, n + 1, Int2Nat(n - 1));

% Actions
act request_d, request_em, request: Loc # Loc; % a passenger at o wants to go to d
	% require different names to perform handshake on action
	stops_d, stops_c, stops: Car # FSet(Nat); % car reads its stop set
	visit_d, visit_c, visit: Car # Nat; % car serves a level with doors open
	move_c, move_em, move: Car # Nat # Nat; % car jumps from one level to another
	open, close: Car; % open / close doors
	enterI_c, enterI_im, enterI_em, enterI: Car; % enter the intersection
	leaveI_c, leaveI_im, leaveI: Car; % leave the intersection
	done: Loc # Loc; % complete a request
	emergency, reset;

% Processes

% Dispatcher
proc Dispatcher(pool: Pool) =
	% add an incoming request
	sum o, d: Loc . (validLoc(o) && validLoc(d) && o != d
		&& #pool < MAXPOOL) % if pool free
		-> request_d(o, d) . Dispatcher(ins(newReq(o, d), pool))
	% expose stops to a Car (offer handshake)
	+ sum e: Car . stops_d(e, stopsOf(e, pool)) . Dispatcher(pool)
	% update pool after a Car visits a stop
	+ sum e: Car, n: Nat . visit_d(e, n) . Dispatcher(afterVisit(e, n, pool))
	% report a finished request and remove it from the pool (cleanup)
	+ sum o, d: Loc . (validLoc(o) && validLoc(d) && hasFinished(o, d, pool))
		-> done(o, d) . Dispatcher(removeFinished(o, d, pool));

% Elevator
proc Elevator(e: Car, pos: Nat, dir: Dir) =
	% read the stop set if there are stops to be served, or if idle on I
	sum S: FSet(Nat) . (S != {} || pos == 3) -> stops_c(e, S) .
		% select next target based on LOOK
		((S != {}) -> Go(e, pos, newDir(pos, dir, S), target(pos, dir, S))
		% no work: step off of I and release mutex
		<> move_c(e, pos, moveOne(pos, dir)) . leaveI_c(e) . Elevator(e, moveOne(pos, dir), dir));
		

% Move to target floor
proc Go(e: Car, pos: Nat, dir: Dir, t: Nat) =
	% if already on target, serve
	(t == pos) -> Serve(e, pos, dir)
	% not crossing intersection: simply move and serve
	<> (!crossIntersection(pos, t)) -> move_c(e, pos, t) . Serve(e, t, dir)
	% stopping at intersection: have to seize mutex first
	<> (t == 3) -> enterI_c(e) . move_c(e, pos, t) . Serve(e, t, dir)
	% leaving intersection: release mutex
	<> (pos == 3) -> move_c(e, pos, t) . leaveI_c(e) . Serve(e, t, dir)
	% crossing intersection: seize, move, then release mutex
	<> enterI_c(e) . move_c(e, pos, t) . leaveI_c(e) . Serve(e, t, dir);

% Serve a floor
proc Serve(e: Car, pos: Nat, dir: Dir) =
	% open doors, visit (offer handshake), close doors, restart loop
	open(e) . visit_c(e, pos) . close(e) . Elevator(e, pos, dir);

% Intersection Manager
proc IntersectionManager(mutex: Mutex) =
	% if free, allow any car to seize the mutex
	(mutex == free) -> sum e: Car . enterI_im(e) . IntersectionManager(heldBy(e))
	% else, wait for current owner to leave
	<> leaveI_im(holder(mutex)) . IntersectionManager(free);

% Emergency Switch on == true -> emergency
proc EmergencySwitch(on: Bool) =
	  (!on) -> emergency . EmergencySwitch(true) % only switch on if its off
	+ (on) -> reset . EmergencySwitch(false) % reset the system
	+ (!on) -> sum e: Car, f1, f2: Nat . move_em(e, f1, f2) . EmergencySwitch(on) % to move, must handshake
	+ (!on) -> sum o, d: Loc . request_em(o, d) . EmergencySwitch(on) % to add request, must handshake
	+ (!on) -> sum e: Car . enterI_em(e) . EmergencySwitch(on); % to enter intersection, must handshake

% Compose with allow
init allow({request, stops, visit, move, open, close, enterI, leaveI, done, emergency, reset},
	comm({stops_d | stops_c -> stops,
		visit_d | visit_c -> visit,
		enterI_c | enterI_im | enterI_em -> enterI,
		leaveI_c | leaveI_im -> leaveI,
		move_c | move_em -> move,
		request_d | request_em -> request},
	Dispatcher([]) || Elevator(A, 1, up) || Elevator(B, 1, up) || IntersectionManager(free) || EmergencySwitch(false)));